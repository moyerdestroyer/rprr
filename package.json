{
  "name": "rprr",
  "version": "0.1.0",
  "description": "Ryan's local-first GitHub PR reviewer",
  "type": "module",
  "bin": {
    "rprr": "./bin/rprr.ts"
  },
  "files": [
    "bin",
    "src",
    "prompts",
    "docs",
    "examples",
    "assets",
    "README.md"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run knip && bun run coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "knip": "knip",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "package:check": "bun scripts/package-check.ts",
    "build:release": "bun scripts/build-release.ts",
    "audit": "bun audit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "knip": "^6.45.0",
    "typescript": "^7.0.2"
  }
}
